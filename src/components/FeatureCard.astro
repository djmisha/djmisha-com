---
/**
 * FeatureCard — a single card inside FeatureGrid: optional icon, title, body slot.
 */
import Icon from './Icon.astro';

export interface Props {
  title: string;
  icon?: import('./Icon.astro').Props['name'];
  iconSize?: string;
  titleIsNotHeading?: boolean;
}

const { title, icon, iconSize = '1.6em', titleIsNotHeading = false } = Astro.props;
---

<article class="feature-card">
  <div class="feature-card__header">
    {
      icon && (
        <span class="feature-card__icon" aria-hidden="true">
          <Icon name={icon} size={iconSize} />
        </span>
      )
    }
    {
      titleIsNotHeading ? (
        <span class="feature-card__title">{title}</span>
      ) : (
        <h3 class="feature-card__title">{title}</h3>
      )
    }
  </div>
  <div class="feature-card__body">
    <slot />
  </div>
</article>

<style>
  .feature-card {
    background: var(--color-bg-secondary);
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-border-faint);
    height: 100%;
  }

  .feature-card__icon {
    display: inline-flex;
    color: var(--color-accent);
    flex: 0 0 auto;
  }

  .feature-card__header {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 0.75em;
  }

  .feature-card__title {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1.35em;
    line-height: 1.5em;
    font-weight: 200;
  }

  @media screen and (max-width: 736px) {
    .feature-card__title {
      font-size: 1.2em;
    }
  }

  .feature-card__body {
    font-weight: 200;
  }

  .feature-card__body :global(:first-child) {
    margin-top: 0;
  }

  .feature-card__body :global(:last-child) {
    margin-bottom: 0;
  }
</style>
