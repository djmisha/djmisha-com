---
/**
 * SectionHeading — shared eyebrow + title + accent rule for landing sections.
 * Ties full-width bands together with a consistent motif.
 */
export interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, align = 'center' } = Astro.props;
---

<header class={`section-heading section-heading--${align}`}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2 class="section-heading__title">{title}</h2>
  <hr class="section-heading__rule" />
</header>

<style>
  .section-heading {
    margin: 0 0 var(--section-heading-gap, 2.5rem) 0;
  }

  .section-heading--center {
    text-align: center;
  }

  .section-heading--left {
    text-align: left;
  }

  .section-heading__eyebrow {
    margin: 0 0 0.6em 0;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .section-heading__title {
    margin: 0;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.15;
    color: var(--color-text-strong);
  }

  .section-heading__rule {
    width: 4em;
    height: 3px;
    border: none;
    background: var(--color-accent);
    margin: 1em 0 0 0;
  }

  .section-heading--center .section-heading__rule {
    margin-left: auto;
    margin-right: auto;
  }
</style>
