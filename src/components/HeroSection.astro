---
export interface Props {
  backgroundImage: string;
  backgroundImages?: string[];
  alt: string;
  /**
   * Anchor selector (e.g. "#intro") the scroll-down link jumps to. Should point
   * at the id of the section immediately following the hero.
   */
  scrollTarget?: string;
}

const { backgroundImage, backgroundImages, alt, scrollTarget } = Astro.props;

// `headline` is the large promotional line (the best quote); `title` is the
// page H1, rendered smaller beneath it.
const hasHeadline = Astro.slots.has('headline');
const hasTitle = Astro.slots.has('title');
---

<section
  class="hero-section"
  style={backgroundImages
    ? 'background-image: none;'
    : `background-image: url('${backgroundImage}');`}
  data-background-images={backgroundImages && JSON.stringify(backgroundImages)}
  aria-label={alt}
>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    {
      hasHeadline && (
        <div class="hero-headline">
          <slot name="headline" />
        </div>
      )
    }
    {hasHeadline && hasTitle && <hr class="hero-divider" />}
    {
      hasTitle && (
        <div class="hero-title">
          <slot name="title" />
        </div>
      )
    }
  </div>
  {
    scrollTarget && (
      <a
        class="hero-scroll-indicator"
        href={scrollTarget}
        aria-label="Scroll down"
      >
        <span class="hero-scroll-arrow">&#8595;</span>
      </a>
    )
  }
</section>

<script>
  function getBackgroundImages(hero: HTMLElement): string[] {
    const serializedImages = hero.dataset.backgroundImages;
    if (!serializedImages) return [];

    const images: unknown = JSON.parse(serializedImages);
    return Array.isArray(images)
      ? images.filter((image): image is string => typeof image === 'string')
      : [];
  }

  function loadRandomHeroImage(hero: HTMLElement) {
    const images = getBackgroundImages(hero);
    if (images.length === 0) return;

    const randomImage = images[Math.floor(Math.random() * images.length)];
    if (randomImage) {
      hero.style.backgroundImage = `url('${randomImage}')`;
    }
  }

  document
    .querySelectorAll<HTMLElement>('.hero-section[data-background-images]')
    .forEach(loadRandomHeroImage);
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: 0;
    padding: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.75) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: absolute;
    top: 66.667%;
    left: 0;
    transform: translateY(-50%);
    z-index: 2;
    text-align: center;
    color: #ffffff;
    padding: 0 1.5em;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* The large promotional line (was the subtagline / quote) */
  .hero-headline {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.15;
    margin: 0 0 20px;
    font-weight: 200;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  .hero-headline :global(p) {
    margin: 0;
  }

  .hero-divider {
    width: 3em;
    height: 2px;
    border: none;
    background: var(--color-accent, #ff2d8a);
    margin: 0 0 0.35rem 0;
  }

  /* The page H1, intentionally smaller and quieter, sitting beneath the headline */
  .hero-title {
    font-size: clamp(0.95rem, 1.5vw, 1.2rem);
    font-weight: 200;
    letter-spacing: 0.04em;
    margin: 0;
    opacity: 0.85;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  .hero-title :global(h1) {
    font-size: inherit;
    font-weight: inherit;
    margin: 0;
    line-height: 1.3;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2em;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: #ffffff;
    text-decoration: none;
    border: none;
    background: transparent;
    padding: 0.25em 0.5em;
    cursor: pointer;
    font-family: inherit;
    font-size: 2rem;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .hero-scroll-indicator:hover {
    opacity: 1;
  }

  .hero-scroll-arrow {
    display: inline-block;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-arrow {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .hero-headline {
      font-size: max(22px, 1.6rem);
      line-height: 1.2;
    }

    .hero-title {
      font-size: max(13px, 0.85rem);
    }
  }
</style>
