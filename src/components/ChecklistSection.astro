---
/**
 * ChecklistSection — styles a slotted list into a two-column checklist with
 * accent check markers. Pass the page's existing <ul>/<li> markup as the slot
 * so content stays identical; an optional intro slot renders above the list.
 */
import SectionHeading from './SectionHeading.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  alt?: boolean;
  id?: string;
}

const { eyebrow, heading, alt = false, id } = Astro.props;
const hasIntro = Astro.slots.has('intro');
---

<section id={id} class:list={['checklist-section', { 'section--alt': alt }]}>
  <div class="checklist-section__inner">
    {heading && <SectionHeading eyebrow={eyebrow} title={heading} />}
    {
      hasIntro && (
        <div class="checklist-section__intro">
          <slot name="intro" />
        </div>
      )
    }
    <div class="checklist-section__list">
      <slot />
    </div>
  </div>
</section>

<style>
  .checklist-section {
    padding: var(--section-padding-y) var(--section-padding-x);
  }

  .checklist-section__inner {
    max-width: var(--section-max-width);
    margin: 0 auto;
  }

  .checklist-section__intro {
    margin-bottom: 1.5em;
  }

  .checklist-section__list :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18em, 1fr));
    gap: 0.85em 2em;
  }

  .checklist-section__list :global(li) {
    position: relative;
    padding-left: 1.9em;
    line-height: 1.55;
  }

  .checklist-section__list :global(li)::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
