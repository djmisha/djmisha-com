---
/**
 * FeatureGrid — responsive container for FeatureCard items (auto-fit columns).
 * Optional eyebrow/heading via SectionHeading. Use `.section--alt` band by
 * passing alt={true}.
 *
 * When `disclosable` is set and a `full` slot is provided, the condensed cards
 * (default slot) become the summary and the `full` slot (the original long-form
 * SEO prose) is revealed on click via the Disclosure primitive (swap mode).
 */
import SectionHeading from './SectionHeading.astro';
import Disclosure from './Disclosure.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  alt?: boolean;
  id?: string;
  disclosable?: boolean;
  showLabel?: string;
  hideLabel?: string;
}

const {
  eyebrow,
  heading,
  alt = false,
  id,
  disclosable = false,
  showLabel = 'See longer explanations',
  hideLabel = 'Show condensed view',
} = Astro.props;

const hasFull = Astro.slots.has('full');
const useDisclosure = disclosable && hasFull;
const detailsId = `${id ?? 'feature-grid'}-full`;
---

<section id={id} class:list={['feature-grid', { 'section--alt': alt }]}>
  <div class="feature-grid__inner">
    {heading && <SectionHeading eyebrow={eyebrow} title={heading} />}
    {
      Astro.slots.has('intro') && (
        <div class="feature-grid__intro">
          <slot name="intro" />
        </div>
      )
    }
    {
      useDisclosure ? (
        <Disclosure
          mode="swap"
          showLabel={showLabel}
          hideLabel={hideLabel}
          id={detailsId}
        >
          <div slot="summary" class="feature-grid__items">
            <slot />
          </div>
          <div slot="details" class="feature-grid__full">
            <slot name="full" />
          </div>
        </Disclosure>
      ) : (
        <div class="feature-grid__items">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .feature-grid {
    padding: var(--section-padding-y) var(--section-padding-x);
  }

  .feature-grid__inner {
    max-width: var(--section-max-width);
    margin: 0 auto;
  }

  .feature-grid__intro {
    max-width: var(--section-text-measure);
    margin: 0 auto var(--section-heading-gap, 2.5rem);
    text-align: center;
  }

  .feature-grid__intro > :global(:first-child) {
    margin-top: 0;
  }

  .feature-grid__intro > :global(:last-child) {
    margin-bottom: 0;
  }

  .feature-grid__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15em, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .feature-grid__full > :global(:first-child) {
    margin-top: 0;
  }

  .feature-grid__full > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
