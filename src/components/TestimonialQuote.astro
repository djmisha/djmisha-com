---
import Icon from './Icon.astro';
import { testimonialBackgroundImages } from '../data/testimonial-backgrounds';

export interface Props {
  quote: string;
  author: string;
}

const { quote, author } = Astro.props;
---

<section
  class="testimonial-quote"
  data-background-images={JSON.stringify(testimonialBackgroundImages)}
>
  <div class="testimonial-quote__image" aria-hidden="true"></div>
  <div class="testimonial-quote__card">
    <p>
      <Fragment set:html={quote} />
      <br />
      <br />
      <span class="author-icon"><Icon name="user" size="0.85em" /></span>
      {author}
    </p>
  </div>
</section>

<script>
  function getBackgroundImages(testimonial: HTMLElement): string[] {
    const serializedImages = testimonial.dataset.backgroundImages;
    if (!serializedImages) return [];

    const images: unknown = JSON.parse(serializedImages);
    return Array.isArray(images)
      ? images.filter((image): image is string => typeof image === 'string')
      : [];
  }

  const testimonials = Array.from(
    document.querySelectorAll<HTMLElement>(
      '.testimonial-quote[data-background-images]',
    ),
  );
  const images = testimonials.length
    ? getBackgroundImages(testimonials[0])
    : [];

  for (let index = images.length - 1; index > 0; index -= 1) {
    const randomIndex = Math.floor(Math.random() * (index + 1));
    [images[index], images[randomIndex]] = [images[randomIndex], images[index]];
  }

  testimonials.forEach((testimonial, index) => {
    const image = images[index % images.length];
    const imageLayer = testimonial.querySelector<HTMLElement>(
      '.testimonial-quote__image',
    );
    if (image && imageLayer) {
      imageLayer.style.backgroundImage = `url('${image}')`;
    }
  });
</script>

<style>
  .testimonial-quote {
    position: relative;
    display: flow-root;
    width: 100%;
    isolation: isolate;
    overflow: clip;
  }

  .testimonial-quote__image {
    position: sticky;
    top: 0;
    z-index: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    margin-bottom: -12vh;
    margin-bottom: -12svh;
    background-color: var(--color-bg-primary);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .testimonial-quote__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.12);
    pointer-events: none;
  }

  .testimonial-quote__card {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: calc(100% - 4rem);
    max-width: 980px;
    margin: -12vh auto 90vh;
    margin: -12svh auto 90svh;
    padding: 40px 20px;
    border-radius: 10px;
    background-color: color-mix(
      in srgb,
      var(--color-bg-tertiary) 90%,
      transparent
    );
    text-align: center;
  }

  .testimonial-quote__card p {
    margin: 0 0 2em 0;
    font-weight: 200;
  }

  .author-icon {
    padding-right: 0.3em;
  }

  .testimonial-quote__card::after {
    content: '';
    position: absolute;
    bottom: -30px;
    left: 20px;
    z-index: 1;
    width: 0;
    height: 0;
    border-left: 20px solid transparent;
    border-right: 30px solid transparent;
    border-top: 40px solid
      color-mix(in srgb, var(--color-bg-tertiary) 90%, transparent);
  }

  @media (max-width: 768px) {
    .testimonial-quote__image {
      position: relative;
      top: auto;
      height: auto;
      aspect-ratio: 4 / 3;
      margin-bottom: 0;
    }

    .testimonial-quote__card {
      width: calc(100% - 2rem);
      margin: -3rem auto 3rem;
      padding: 1.75rem 1.25rem;
    }
  }
</style>
