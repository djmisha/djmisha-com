---
/**
 * SectionNav — centered anchor links to in-page section ids.
 * Sticky under the site nav by default. Replaces a bare <ul> table of contents.
 */
export interface NavLink {
  label: string;
  href: string;
}

export interface Props {
  links: NavLink[];
  sticky?: boolean;
}

const { links, sticky = false } = Astro.props;
---

<nav
  class:list={['section-nav', { 'section-nav--sticky': sticky }]}
  aria-label="On this page"
>
  <ul class="section-nav__list">
    {
      links.map((link) => (
        <li>
          <a class="section-nav__link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .section-nav {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border-faint);
    border-bottom: 1px solid var(--color-border-faint);
    padding: 0.75em var(--section-padding-x);
  }

  .section-nav--sticky {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .section-nav__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--section-max-width);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75em 1em;
  }

  .section-nav__list li {
    display: flex;
    align-items: center;
    gap: 1em;
  }

  .section-nav__list li:not(:last-child)::after {
    content: '•';
    color: #fff;
  }

  .section-nav__link {
    display: inline-block;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 200;
    border-bottom: dotted 1px rgba(255, 255, 255, 0.35);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .section-nav__link:hover {
    color: var(--color-text-strong);
    border-bottom-color: currentColor;
  }

  @media (max-width: 600px) {
    .section-nav__list {
      flex-direction: column;
      align-items: center;
      gap: 0.125em;
    }

    .section-nav__list li {
      flex-direction: column;
      gap: 0;
    }

    .section-nav__list li::after {
      display: none;
    }

    .section-nav__link {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-nav__link {
      transition: none;
    }
  }
</style>
