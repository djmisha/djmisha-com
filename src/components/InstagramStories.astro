---
/**
 * Standalone, self-contained Instagram stories showcase component.
 *
 * Swap in real post URLs, image paths, and captions in the `stories` array below.
 * Keep eventual image files in `/public/images/` (for example
 * `/public/images/instagram/dj-misha-story-1.jpg`) and replace the placeholder
 * values with those paths before mounting this component on a page.
 */
const CAPTION_PREVIEW_LIMIT = 125;

type Story = {
  url: string;
  image: string;
  alt: string;
  caption: string;
};

const stories: Story[] = [
  {
    url: 'https://www.instagram.com/djmishasd/',
    image: '',
    alt: 'Placeholder DJ Misha Instagram story preview',
    caption:
      'Placeholder caption: this one is intentionally short so the preview stays within the limit.',
  },
  {
    url: 'https://www.instagram.com/djmishasd/',
    image: '',
    alt: 'Placeholder DJ Misha Instagram story preview',
    caption:
      'Placeholder caption: this version is a little longer and should still fit the preview without forcing a cut because it remains under the limit.',
  },
  {
    url: 'https://www.instagram.com/djmishasd/',
    image: '',
    alt: 'Placeholder DJ Misha Instagram story preview',
    caption:
      'Placeholder caption: this one is intentionally much longer than the preview limit so it demonstrates the truncation behavior and the “… more” suffix when the caption is clipped to the site’s preview length.',
  },
];

const getCaptionPreview = (caption: string) => {
  const normalized = caption.replace(/\s+/g, ' ').trim();

  if (!normalized) {
    return '';
  }

  if (normalized.length <= CAPTION_PREVIEW_LIMIT) {
    return normalized;
  }

  return `${normalized.slice(0, CAPTION_PREVIEW_LIMIT).trimEnd()}… more`;
};
---

<section class="instagram-stories" aria-labelledby="instagram-stories-title">
  <div class="instagram-stories__header">
    <h2 id="instagram-stories-title">See DJ Misha in action</h2>
    <p class="instagram-stories__subtitle">Peak hour moments</p>
  </div>

  <ul class="instagram-stories__list">
    {
      stories.map((story) => {
        const captionPreview = getCaptionPreview(story.caption);
        const thumbClass = story.image
          ? 'instagram-stories__thumb'
          : 'instagram-stories__thumb is-placeholder';

        return (
          <li class="instagram-stories__item">
            <a
              class="instagram-stories__card"
              href={story.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open DJ Misha Instagram story in a new tab: ${
                captionPreview || 'Instagram story'
              }`}
            >
              <span class={thumbClass}>
                {story.image && (
                  <img
                    src={story.image}
                    alt={story.alt}
                    loading="lazy"
                    onerror="this.style.display='none'; this.parentElement.classList.add('is-placeholder');"
                  />
                )}
                <span
                  class="instagram-stories__placeholder"
                  aria-hidden="true"
                />
              </span>

              {captionPreview && (
                <span class="instagram-stories__caption">{captionPreview}</span>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .instagram-stories {
    width: min(100%, 1200px);
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 5rem) 0;
    color: var(--color-text-strong);
  }

  .instagram-stories__header {
    margin-bottom: 1.75rem;
  }

  .instagram-stories__header h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-strong);
    font-weight: 700;
  }

  .instagram-stories__subtitle {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .instagram-stories__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .instagram-stories__item {
    margin: 0;
  }

  .instagram-stories__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0;
    overflow: hidden;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .instagram-stories__card:hover {
    background: var(--color-bg-hover);
    border-color: var(--color-accent);
  }

  .instagram-stories__card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-stories__card {
      transition: none;
    }
  }

  .instagram-stories__thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .instagram-stories__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--color-bg-primary);
  }

  .instagram-stories__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.08),
        rgba(255, 255, 255, 0.02)
      ),
      var(--color-bg-primary);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .instagram-stories__thumb.is-placeholder .instagram-stories__placeholder {
    opacity: 1;
  }

  .instagram-stories__thumb.is-placeholder::before,
  .instagram-stories__thumb.is-placeholder::after {
    content: '';
    position: absolute;
    inset: auto;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.04);
  }

  .instagram-stories__thumb.is-placeholder::before {
    width: 38%;
    height: 58%;
    left: 31%;
    top: 18%;
    border-color: rgba(255, 45, 138, 0.6);
  }

  .instagram-stories__thumb.is-placeholder::after {
    width: 54%;
    height: 12%;
    left: 23%;
    bottom: 18%;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .instagram-stories__caption {
    display: block;
    padding: 0.9rem 1rem 1.05rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-strong);
    overflow-wrap: anywhere;
    word-break: break-word;
    white-space: normal;
  }

  @media (max-width: 768px) {
    .instagram-stories__list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .instagram-stories__thumb {
      aspect-ratio: 4 / 5;
    }
  }
</style>
