---
/**
 * Disclosure — show a condensed `summary` by default and reveal the full
 * `details` content on click. BOTH slots are server-rendered into the static
 * HTML (no fetch), so the full/original copy is always crawlable on load; it is
 * only visually collapsed once JS is active (see the html.js gate). With JS off,
 * everything is visible and the toggle is hidden — nothing is ever lost.
 *
 * mode="swap"     — hide the summary when details open (e.g. cards -> full prose)
 * mode="additive" — keep the summary; details expand beneath it
 */
export interface Props {
  mode?: 'swap' | 'additive';
  showLabel: string;
  hideLabel: string;
  /** id for the details region, paired to the button via aria-controls */
  id: string;
}

const { mode = 'additive', showLabel, hideLabel, id } = Astro.props;
---

<div class:list={['disclosure', `disclosure--${mode}`]} data-disclosure>
  <div class="disclosure__summary">
    <slot name="summary" />
  </div>

  <div class="collapsible" id={id} data-collapsed>
    <div class="collapsible__inner">
      <div class="disclosure__details">
        <slot name="details" />
      </div>
    </div>
  </div>

  <div class="disclosure-actions">
    <button
      class="button disclosure-toggle"
      type="button"
      data-disclosure-toggle
      data-show={showLabel}
      data-hide={hideLabel}
      aria-expanded="false"
      aria-controls={id}
    >
      <span data-label>{showLabel}</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('[data-disclosure]').forEach((root) => {
    const btn = root.querySelector('[data-disclosure-toggle]');
    const region = root.querySelector('.collapsible');
    const label = btn?.querySelector('[data-label]');
    if (!btn || !region) return;

    btn.addEventListener('click', () => {
      const collapsed = region.hasAttribute('data-collapsed');
      // collapsed === true means it is currently closed -> we are opening it
      region.toggleAttribute('data-collapsed', !collapsed);
      root.toggleAttribute('data-open', collapsed);
      btn.setAttribute('aria-expanded', String(collapsed));
      if (label) {
        label.textContent = collapsed
          ? ((btn as HTMLElement).dataset.hide ?? '')
          : ((btn as HTMLElement).dataset.show ?? '');
      }
    });
  });
</script>

<style>
  /* When details are open in swap mode, the condensed summary is removed from
     both layout and the a11y tree so only one pane is present at a time. */
  :global(html.js) .disclosure--swap[data-open] .disclosure__summary {
    display: none;
  }

  .disclosure__details > :global(:first-child) {
    margin-top: 0;
  }

  .disclosure__details > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
