---
/**
 * TimelineSection — vertical timeline container for TimelineItem entries.
 *
 * When `expandable` is set, a single section-level "See more details" button
 * reveals the `details` slot of every TimelineItem at once (additive: each
 * item's overview stays visible). All details are server-rendered and only
 * collapsed when JS is active, so they remain crawlable on load.
 */
import SectionHeading from './SectionHeading.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  alt?: boolean;
  id?: string;
  expandable?: boolean;
  showLabel?: string;
  hideLabel?: string;
}

const {
  eyebrow,
  heading,
  alt = false,
  id,
  expandable = false,
  showLabel = 'See more details',
  hideLabel = 'Hide details',
} = Astro.props;
---

<section
  id={id}
  class:list={['timeline-section', { 'section--alt': alt }]}
  data-timeline
>
  <div class="timeline-section__inner">
    {heading && <SectionHeading eyebrow={eyebrow} title={heading} />}
    {
      Astro.slots.has('intro') && (
        <div class="timeline-section__intro">
          <slot name="intro" />
        </div>
      )
    }
    <ol class="timeline">
      <slot />
    </ol>
    {
      expandable && (
        <div class="disclosure-actions">
          <button
            class="button disclosure-toggle"
            type="button"
            data-timeline-toggle
            data-show={showLabel}
            data-hide={hideLabel}
            aria-expanded="false"
          >
            <span data-label>{showLabel}</span>
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll('[data-timeline-toggle]').forEach((btn) => {
    const root = btn.closest('[data-timeline]');
    if (!root) return;
    const regions = root.querySelectorAll('.collapsible');
    const label = btn.querySelector('[data-label]');

    btn.addEventListener('click', () => {
      const open = root.hasAttribute('data-open');
      root.toggleAttribute('data-open', !open);
      // open === true means currently expanded -> collapse all (add data-collapsed)
      regions.forEach((r) => r.toggleAttribute('data-collapsed', open));
      btn.setAttribute('aria-expanded', String(!open));
      if (label) {
        label.textContent = open
          ? ((btn as HTMLElement).dataset.show ?? '')
          : ((btn as HTMLElement).dataset.hide ?? '');
      }
    });
  });
</script>

<style>
  .timeline-section {
    padding: var(--section-padding-y) var(--section-padding-x);
  }

  .timeline-section__inner {
    max-width: var(--section-text-measure);
    margin: 0 auto;
  }

  .timeline-section__intro > :global(:last-child) {
    margin-bottom: 2em;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* The vertical spine */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-border);
  }
</style>
