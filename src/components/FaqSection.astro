---
import SectionHeading from './SectionHeading.astro';

export interface Props {
  eyebrow?: string;
  heading?: string;
  id?: string;
}

const { eyebrow, heading, id } = Astro.props;

const html = await Astro.slots.render('default');
const hasContent = html && html.trim().length > 0;
---

{
  hasContent && (
    <section id={id} class="faq-section">
      {heading && <SectionHeading eyebrow={eyebrow} title={heading} />}
      <slot />
    </section>
  )
}

<script>
  document.querySelectorAll('.faq-section').forEach((section) => {
    section.querySelectorAll('.faq-question').forEach((button) => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
      });
    });
  });
</script>

<style>
  .faq-section {
    padding: var(--section-padding-y) var(--section-padding-x);
    max-width: var(--section-max-width);
    margin: 0 auto;
  }

  .faq-section :global(.faq-item) {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-section :global(.faq-item:first-child) {
    border-top: 1px solid var(--color-border);
  }

  .faq-section :global(.faq-question) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.25em 0;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: normal;
    text-align: left;
    color: inherit;
    font-family: inherit;
    transition: color 0.2s ease;
  }

  .faq-section :global(.faq-question:hover) {
    color: var(--color-accent);
  }

  .faq-section :global(.faq-question[aria-expanded='true']) {
    color: var(--color-accent);
  }

  .faq-section :global(.faq-question:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .faq-section :global(.faq-icon) {
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 1em;
  }

  .faq-section :global(.faq-question[aria-expanded='true'] .faq-icon) {
    transform: rotate(45deg);
  }

  /* Animate open/close via grid-template-rows (0fr -> 1fr) */
  .faq-section :global(.faq-answer) {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .faq-section :global(.faq-question[aria-expanded='true'] + .faq-answer) {
    grid-template-rows: 1fr;
  }

  .faq-section :global(.faq-answer__inner) {
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0.3s;
  }

  .faq-section
    :global(
      .faq-question[aria-expanded='true'] + .faq-answer .faq-answer__inner
    ) {
    visibility: visible;
  }

  .faq-section :global(.faq-answer__inner > *:first-child) {
    margin-top: 0;
    padding-top: 0;
  }

  .faq-section :global(.faq-answer__inner > *:last-child) {
    margin-bottom: 1.25em;
  }

  .faq-section :global(.faq-question-text) {
    font-size: inherit;
    font-weight: normal;
    margin: 0;
  }

  .faq-section :global(.faq-answer p) {
    margin: 0 0 1em 0;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Opened-answer rich content: lists, list items, and links */
  .faq-section :global(.faq-answer ul),
  .faq-section :global(.faq-answer ol) {
    margin: 0 0 1em 0;
    line-height: 1.6;
    color: var(--color-text);
  }

  .faq-section :global(.faq-answer ul) {
    list-style: disc;
    padding-left: 1.25em;
  }

  .faq-section :global(.faq-answer ol) {
    list-style: decimal;
    padding-left: 1.25em;
  }

  .faq-section :global(.faq-answer li) {
    margin: 0 0 0.4em 0;
    padding-left: 0.25em;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-section :global(.faq-answer),
    .faq-section :global(.faq-answer__inner),
    .faq-section :global(.faq-icon),
    .faq-section :global(.faq-question) {
      transition: none;
    }
  }
</style>
