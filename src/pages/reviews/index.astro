---
import FullWidthLayout from '../../layouts/FullWidthLayout.astro';
import { buildJsonLdWithRating } from '../../data/schema';
import {
  extractInitials,
  formatRelativeReviewDate,
  formatReviewDate,
} from '../../lib/reviews-helpers.mjs';
import reviewsData from '../../data/reviews.json';

const { totalRating, totalReviews, keywords, reviews } = reviewsData;
const reviewsWithText = reviews
  .filter((review) => review.text.trim().length > 0)
  .sort((a, b) => b.time - a.time);
const ratingOnlyReviews = reviews
  .filter((review) => review.text.trim().length === 0)
  .sort((a, b) => b.time - a.time);
const displayReviews = [...reviewsWithText, ...ratingOnlyReviews];

// Compute badge counts from actual review keyword tags (ensures consistency
// between the number shown on the pill and the cards displayed when clicked)
const badgeCounts: Record<string, number> = {};
for (const kw of keywords) {
  badgeCounts[kw] = reviews.filter((r) => r.keywords.includes(kw)).length;
}

const jsonLd = buildJsonLdWithRating(
  { ratingValue: totalRating, reviewCount: totalReviews },
  {
    '@context': 'http://schema.org/',
    '@type': 'WebPage',
    url: 'https://djmisha.com/reviews/',
    headline: 'Reviews & Testimonials',
    mainEntityOfPage: 'https://djmisha.com/reviews/',
  },
);

const reviewsDesc =
  "Looking for a San Diego DJ who can make your event unforgettable? Read testimonials from satisfied clients about DJ Misha's music selection, energy, and professionalism.";
---

<FullWidthLayout
  title="DJ Misha Reviews - See What Our Clients Are Saying"
  heading="Reviews & Testimonials"
  description={reviewsDesc}
  canonicalUrl="https://djmisha.com/reviews/"
  ogTitle="DJ Misha Reviews - See What Our Clients Are Saying"
  ogImage="https://djmisha.com/images/Best-San-Diego-DJ-djmisha.com-12.jpg"
  ogUrl="https://djmisha.com/reviews/"
  ogType="website"
  twitterTitle="DJ Misha Reviews - See What Our Clients Are Saying"
  twitterImage="https://djmisha.com/images/Best-San-Diego-DJ-djmisha.com-12.jpg"
  jsonLd={jsonLd}
>
  <p>
    DJ Misha is a San Diego DJ who has been providing high-quality DJ services
    for many years. He is known for his extensive curated music collection, his
    ability to read the crowd, and his professionalism. DJ Misha has played at a
    variety of events, including weddings, corporate parties, private functions
    and festivals.
  </p>

  <!-- Keyword Pills -->
  <div class="keyword-pills">
    <button class="keyword-pill active" data-keyword="all">
      All <span class="pill-badge">{reviews.length}</span>
    </button>
    {
      keywords.map((kw) => (
        <button class="keyword-pill" data-keyword={kw}>
          {kw} <span class="pill-badge">{badgeCounts[kw]}</span>
        </button>
      ))
    }
  </div>

  <!-- Review Cards -->
  <div class="reviews-grid">
    {
      displayReviews.map((review) => (
        <article
          class="review-card"
          data-keywords={review.keywords.join(',')}
          data-review-time={review.time}
        >
          <div class="review-card-header">
            {review.profilePhoto ? (
              <img
                class="review-avatar"
                src={review.profilePhoto}
                alt={`${review.author} profile photo`}
                width="68"
                height="68"
                loading="lazy"
              />
            ) : (
              <div class="review-avatar review-avatar-fallback">
                {extractInitials(review.author)}
              </div>
            )}
            <div class="review-meta">
              <span class="review-author">{review.author}</span>
              <div class="review-when">
                <time class="review-date" datetime={review.date}>
                  {formatReviewDate(review.date)}
                </time>
                <span class="review-age" data-review-date={review.date}>
                  {formatRelativeReviewDate(review.date)}
                </span>
              </div>
            </div>
          </div>
          <div
            class="review-stars"
            aria-label={`${review.rating} out of 5 stars`}
          >
            {Array.from({ length: 5 }).map((_, i) => (
              <span
                class={`star ${i < review.rating ? 'star-filled' : 'star-empty'}`}
              >
                &#9733;
              </span>
            ))}
          </div>
          {review.text && <p class="review-text">{review.text}</p>}
          <div class="review-card__footer">
            <a
              class="button small review-view-more"
              href={`#review-detail-${review.id}`}
              data-fancybox="reviews"
              data-type="inline"
              aria-label={`Read more: full review by ${review.author}`}
            >
              Read more
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Full review text stays in the HTML for SEO and Fancybox inline slides. -->
  <div class="review-detail-sources" hidden>
    {
      displayReviews.map((review) => (
        <div id={`review-detail-${review.id}`} class="review-lightbox">
          <div class="review-lightbox__scroll" tabindex="0">
            <div class="review-lightbox__inner">
              <div class="review-card-header">
                {review.profilePhoto ? (
                  <img
                    class="review-avatar"
                    src={review.profilePhoto}
                    alt={`${review.author} profile photo`}
                    width="96"
                    height="96"
                  />
                ) : (
                  <div class="review-avatar review-avatar-fallback">
                    {extractInitials(review.author)}
                  </div>
                )}
                <div class="review-meta">
                  <span class="review-author">{review.author}</span>
                  <div class="review-when">
                    <time class="review-date" datetime={review.date}>
                      {formatReviewDate(review.date)}
                    </time>
                    <span class="review-age" data-review-date={review.date}>
                      {formatRelativeReviewDate(review.date)}
                    </span>
                  </div>
                </div>
              </div>
              <div
                class="review-stars"
                aria-label={`${review.rating} out of 5 stars`}
              >
                {Array.from({ length: 5 }).map((_, i) => (
                  <span
                    class={`star ${i < review.rating ? 'star-filled' : 'star-empty'}`}
                  >
                    &#9733;
                  </span>
                ))}
              </div>
              {review.text && (
                <p class="review-lightbox__text">{review.text}</p>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <section
    slot="full-width-bottom"
    id="five"
    class="reviews-cta wrapper style2 special fade"
  >
    <div class="container">
      <header>
        <h2>San Diego DJ Reviews and Testimonials</h2>
        <p>Read more testimonials for DJ Misha on his Google profile.</p>
      </header>
      <ul class="actions special">
        <li>
          <a
            class="button special"
            href="https://www.google.com/maps/place/DJ+Misha/@32.7990179,-117.2530949,9z/data=!3m1!5s0x80dc019320e5a943:0x21495feab25fb788!4m18!1m9!1s0x80dbffcb31404e13:0x3fae10d8742ab418!2sDJ+Misha!8m2!3d32.798797!4d-117.2528273!9m1!1b1!16s%2Fg%2F1hm4n666z!3m7!1s0x80dbffcb31404e13:0x3fae10d8742ab418!8m2!3d32.798797!4d-117.2528273!9m1!1b1!16s%2Fg%2F1hm4n666z"
            target="_blank"
            rel="noopener">Google Reviews</a
          >
        </li>
      </ul>
    </div>
  </section>

  <script src="/js/reviews-filter.js" defer></script>
  <script src="/js/reviews-lightbox.js" defer></script>
  <script>
    import { formatRelativeReviewDate } from '../../lib/reviews-helpers.mjs';

    document
      .querySelectorAll('.review-age[data-review-date]')
      .forEach((pill) => {
        const isoDate = pill.getAttribute('data-review-date');
        if (!isoDate) return;
        pill.textContent = formatRelativeReviewDate(isoDate);
      });
  </script>
</FullWidthLayout>

<style>
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 1.5em;
    margin-bottom: 3em;
  }

  .review-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    height: 100%;
    min-width: 0;
    position: relative;
    cursor: pointer;
  }

  .review-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: pre-line;
    overflow-wrap: break-word;
  }

  .review-card .review-card-header,
  .review-lightbox .review-card-header {
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .review-card .review-avatar,
  .review-card .review-avatar-fallback {
    width: 68px;
    height: 68px;
    box-shadow:
      0 0 0 3px var(--color-bg-primary),
      0 0 0 4px var(--color-border);
  }

  .review-meta {
    align-items: center;
    width: 100%;
    min-width: 0;
  }

  .review-author {
    max-width: 100%;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .review-when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
  }

  .review-age {
    display: inline-flex;
    align-items: center;
    padding: 0.12em 0.55em;
    border-radius: 2em;
    background: var(--color-pill-bg);
    color: var(--color-text-muted);
    box-shadow: inset 0 0 0 1px var(--color-pill-border);
    font-size: 0.72em;
    font-weight: 300;
    line-height: 1.4;
    white-space: nowrap;
  }

  .review-card__footer {
    margin-top: auto;
    padding-top: 1em;
    text-align: center;
  }

  .review-card .review-stars,
  .review-lightbox .review-stars {
    text-align: center;
  }

  /*
    The site stylesheet zeros .button padding at max-width 480px. These
    rules are more specific than that reset and set the tap target directly.
  */
  a.button.review-view-more {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: auto;
    min-height: 44px;
    padding: 10px 18px;
    line-height: 1.3;
  }

  .review-view-more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .review-card--measured:not(.review-card--overflow) .review-card__footer {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .review-card--measured:not(.review-card--overflow):focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .review-card--measured:not(.review-card--overflow)
    .review-view-more:focus-visible {
    outline: none;
  }

  .review-detail-sources {
    display: none;
  }

  :global(.fancybox-slide.review-fancybox-slide) {
    padding: 0;
    overflow: hidden;
  }

  :global(.fancybox-slide.review-fancybox-slide::before) {
    display: none;
  }

  .review-lightbox {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-text);
    font-family: var(--font-family);
    font-weight: 300;
    text-align: left;
    vertical-align: top;
  }

  .review-lightbox__scroll {
    box-sizing: border-box;
    height: 100%;
    max-height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    touch-action: pan-y;
    padding: clamp(3.25rem, 7vw, 4.5rem) clamp(6.5rem, 10vw, 8rem)
      clamp(1.75rem, 4vw, 3rem);
    scrollbar-color: var(--color-border) transparent;
  }

  .review-lightbox__inner {
    width: min(100%, 65ch);
    margin: 0 auto;
  }

  @media screen and (min-width: 737px) {
    .review-lightbox__scroll {
      display: flex;
      flex-direction: column;
    }

    .review-lightbox__inner {
      margin-block: auto;
    }
  }

  .review-lightbox .review-card-header {
    margin-bottom: 1rem;
  }

  .review-lightbox .review-avatar,
  .review-lightbox .review-avatar-fallback {
    width: 96px;
    height: 96px;
  }

  .review-lightbox .review-author {
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.8rem);
    font-weight: 400;
  }

  .review-lightbox .review-date {
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.1rem);
  }

  .review-lightbox .review-age {
    font-size: 0.8rem;
  }

  .review-lightbox .review-stars {
    margin-bottom: 1.25rem;
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.7rem);
  }

  .review-lightbox__text {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    font-weight: 300;
    line-height: 1.65;
    white-space: pre-line;
    overflow-wrap: break-word;
  }

  :global(.fancybox-can-drag) .review-lightbox,
  :global(.fancybox-can-drag) .review-lightbox__scroll {
    cursor: auto;
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button) {
    width: 64px;
    height: 64px;
    margin: 0;
    opacity: 1;
    padding: 16px;
    top: 50%;
    transform: translateY(-50%);
    visibility: visible;
    background: transparent;
    border: 0;
    border-radius: var(--border-radius);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text-strong);
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button svg) {
    width: 100%;
    height: 100%;
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button::after) {
    content: none;
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button--arrow_left) {
    left: 16px;
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button--arrow_right) {
    right: 16px;
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button:hover),
  :global(.review-fancybox .fancybox-navigation .fancybox-button:active) {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-accent);
    color: var(--color-accent);
  }

  :global(
    .review-fancybox .fancybox-navigation .fancybox-button:focus-visible
  ) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  :global(.review-fancybox .fancybox-navigation) {
    z-index: 99995;
  }

  :global(.review-fancybox .fancybox-navigation .fancybox-button.disabled),
  :global(
    .review-fancybox .fancybox-navigation .fancybox-button.disabled:hover
  ) {
    box-shadow: inset 0 0 0 1px var(--color-border-faint);
    color: var(--color-text-muted);
    cursor: default;
  }

  @media screen and (max-width: 1200px) {
    .reviews-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 736px) {
    .reviews-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1em;
    }

    .review-lightbox__scroll {
      padding-right: 1rem;
      padding-bottom: 8rem;
      padding-left: 1rem;
    }

    :global(.review-fancybox .fancybox-navigation) {
      position: absolute;
      right: auto;
      bottom: 3rem;
      left: 50%;
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      width: auto;
      transform: translateX(-50%);
    }

    :global(.review-fancybox .fancybox-navigation .fancybox-button) {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      width: 48px;
      height: 48px;
      transform: none;
      padding: 10px;
    }
  }

  @media screen and (max-width: 480px) {
    a.button.review-view-more {
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: auto;
      min-height: 44px;
      padding: 10px 18px;
      line-height: 1.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-card {
      transition: none;
    }

    :global(.review-fancybox .fancybox-bg),
    :global(.review-fancybox .fancybox-slide),
    :global(.review-fancybox .fancybox-button) {
      transition: none;
    }
  }
</style>
