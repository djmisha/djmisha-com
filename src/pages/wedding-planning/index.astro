<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Wedding planning questions for DJ Misha. Share your timeline, music preferences, lighting needs, and planning details."
    />
    <title>Wedding Planning Questionnaire | DJ Misha</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/wedding-planning/pf.css" />
  </head>
  <body class="pf-page">
    <main class="pf-shell" aria-live="polite">
      <div id="pf-access" class="pf-access" hidden>
        <div class="pf-card pf-card--narrow">
          <p class="pf-eyebrow">Access required</p>
          <h1>We need your personalized link</h1>
          <p>
            Please use the link DJ Misha emailed you. This questionnaire is only
            available to couples who arrived from that personalized invitation.
          </p>
        </div>
      </div>

      <form
        id="pf-form"
        class="pf-form"
        method="post"
        action="/php/process-wedding-planning.php"
        novalidate
      >
        <input type="hidden" name="name" value="" />
        <input type="hidden" name="website" value="" />

        <header class="pf-header" aria-live="polite">
          <div class="pf-progress-track" aria-hidden="true">
            <span id="pf-progress-fill" class="pf-progress-fill"></span>
          </div>

          <div class="pf-header-row">
            <div class="pf-progress-meta">
              <div id="pf-step-label" class="pf-step-label">Step 1 of 19</div>
            </div>
          </div>
        </header>

        <div class="pf-body">
          <section
            class="pf-step pf-screen"
            data-step="0"
            data-section="welcome"
          >
            <div class="pf-screen-card">
              <p class="pf-eyebrow">Welcome</p>
              <h1 id="pf-welcome-name">Hi there!</h1>
              <p class="pf-lead">
                A few quick questions to help us focus on what matters most to
                you. It only takes a few minutes.
              </p>
              <p class="pf-lead">
                DJ Misha will review your answers and be prepared to continue
                the conversation.
              </p>
            </div>
          </section>

          <section class="pf-step" data-step="1" data-section="Your day" hidden>
            <p class="pf-section-kicker">Parts of your day</p>
            <h2>Which parts of your day would you like us involved in?</h2>
            <p class="pf-help">Select all that apply.</p>

            <fieldset class="pf-choice-group pf-checkbox-group">
              <label class="pf-choice">
                <input type="checkbox" name="parts_of_day[]" value="ceremony" />
                <span>Ceremony</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="parts_of_day[]"
                  value="cocktail_hour"
                />
                <span>Cocktail hour</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="parts_of_day[]"
                  value="reception"
                />
                <span>Reception</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="parts_of_day[]"
                  value="afterparty"
                />
                <span>Afterparty</span>
              </label>
            </fieldset>
            <p class="pf-error" data-error-for="parts_of_day"></p>
          </section>

          <section class="pf-step" data-step="2" data-section="Your day" hidden>
            <p class="pf-section-kicker">Your timeline</p>
            <h2>What does your event timeline look like?</h2>
            <p class="pf-help">
              Tap the buttons to tweak your estimated start and end times in
              30-minute steps. Rough estimates are perfect.
            </p>
            <div
              class="pf-timeline-stepper"
              data-timeline-section="ceremony"
              hidden
            >
              <h3>💍 Ceremony</h3>
              <div class="pf-time-row">
                <span class="pf-time-label">Start</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_ceremony_start"
                    data-direction="-1"
                    aria-label="Earlier ceremony start time">−</button
                  >
                  <output
                    data-time-display="timeline_ceremony_start"
                    for="timeline_ceremony_start">4:30 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_ceremony_start"
                    data-direction="1"
                    aria-label="Later ceremony start time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_ceremony_start"
                  name="timeline_ceremony_start"
                  value="16:30"
                />
              </div>
              <div class="pf-time-row">
                <span class="pf-time-label">End</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_ceremony_end"
                    data-direction="-1"
                    aria-label="Earlier ceremony end time">−</button
                  >
                  <output
                    data-time-display="timeline_ceremony_end"
                    for="timeline_ceremony_end">5:30 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_ceremony_end"
                    data-direction="1"
                    aria-label="Later ceremony end time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_ceremony_end"
                  name="timeline_ceremony_end"
                  value="17:30"
                />
              </div>
            </div>
            <div
              class="pf-timeline-stepper"
              data-timeline-section="cocktail_hour"
              hidden
            >
              <h3>🍸 Cocktail Hour</h3>
              <div class="pf-time-row">
                <span class="pf-time-label">Start</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_cocktail_hour_start"
                    data-direction="-1"
                    aria-label="Earlier cocktail hour start time">−</button
                  >
                  <output
                    data-time-display="timeline_cocktail_hour_start"
                    for="timeline_cocktail_hour_start">5:30 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_cocktail_hour_start"
                    data-direction="1"
                    aria-label="Later cocktail hour start time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_cocktail_hour_start"
                  name="timeline_cocktail_hour_start"
                  value="17:30"
                />
              </div>
              <div class="pf-time-row">
                <span class="pf-time-label">End</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_cocktail_hour_end"
                    data-direction="-1"
                    aria-label="Earlier cocktail hour end time">−</button
                  >
                  <output
                    data-time-display="timeline_cocktail_hour_end"
                    for="timeline_cocktail_hour_end">6:30 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_cocktail_hour_end"
                    data-direction="1"
                    aria-label="Later cocktail hour end time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_cocktail_hour_end"
                  name="timeline_cocktail_hour_end"
                  value="18:30"
                />
              </div>
            </div>
            <div
              class="pf-timeline-stepper"
              data-timeline-section="reception_dinner"
              hidden
            >
              <h3>🍽️ Reception &amp; Dinner</h3>
              <div class="pf-time-row">
                <span class="pf-time-label">Start</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_reception_dinner_start"
                    data-direction="-1"
                    aria-label="Earlier reception and dinner start time"
                    >−</button
                  >
                  <output
                    data-time-display="timeline_reception_dinner_start"
                    for="timeline_reception_dinner_start">6:30 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_reception_dinner_start"
                    data-direction="1"
                    aria-label="Later reception and dinner start time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_reception_dinner_start"
                  name="timeline_reception_dinner_start"
                  value="18:30"
                />
              </div>
              <div class="pf-time-row">
                <span class="pf-time-label">End</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_reception_dinner_end"
                    data-direction="-1"
                    aria-label="Earlier reception and dinner end time">−</button
                  >
                  <output
                    data-time-display="timeline_reception_dinner_end"
                    for="timeline_reception_dinner_end">8:00 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_reception_dinner_end"
                    data-direction="1"
                    aria-label="Later reception and dinner end time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_reception_dinner_end"
                  name="timeline_reception_dinner_end"
                  value="20:00"
                />
              </div>
            </div>
            <div
              class="pf-timeline-stepper"
              data-timeline-section="dance_party"
              hidden
            >
              <h3>🪩 Dance Party</h3>
              <div class="pf-time-row">
                <span class="pf-time-label">Start</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_dance_party_start"
                    data-direction="-1"
                    aria-label="Earlier dance party start time">−</button
                  >
                  <output
                    data-time-display="timeline_dance_party_start"
                    for="timeline_dance_party_start">8:00 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_dance_party_start"
                    data-direction="1"
                    aria-label="Later dance party start time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_dance_party_start"
                  name="timeline_dance_party_start"
                  value="20:00"
                />
              </div>
              <div class="pf-time-row">
                <span class="pf-time-label">End</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_dance_party_end"
                    data-direction="-1"
                    aria-label="Earlier dance party end time">−</button
                  >
                  <output
                    data-time-display="timeline_dance_party_end"
                    for="timeline_dance_party_end">10:00 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_dance_party_end"
                    data-direction="1"
                    aria-label="Later dance party end time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_dance_party_end"
                  name="timeline_dance_party_end"
                  value="22:00"
                />
              </div>
            </div>
            <div
              class="pf-timeline-stepper"
              data-timeline-section="afterparty"
              hidden
            >
              <h3>🎉 Afterparty</h3>
              <div class="pf-time-row">
                <span class="pf-time-label">Start</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_afterparty_start"
                    data-direction="-1"
                    aria-label="Earlier afterparty start time">−</button
                  >
                  <output
                    data-time-display="timeline_afterparty_start"
                    for="timeline_afterparty_start">10:00 PM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_afterparty_start"
                    data-direction="1"
                    aria-label="Later afterparty start time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_afterparty_start"
                  name="timeline_afterparty_start"
                  value="22:00"
                />
              </div>
              <div class="pf-time-row">
                <span class="pf-time-label">End</span>
                <div class="pf-time-control">
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_afterparty_end"
                    data-direction="-1"
                    aria-label="Earlier afterparty end time">−</button
                  >
                  <output
                    data-time-display="timeline_afterparty_end"
                    for="timeline_afterparty_end">12:00 AM</output
                  >
                  <button
                    type="button"
                    class="pf-time-adjust"
                    data-time-field="timeline_afterparty_end"
                    data-direction="1"
                    aria-label="Later afterparty end time">+</button
                  >
                </div>
                <input
                  type="hidden"
                  id="timeline_afterparty_end"
                  name="timeline_afterparty_end"
                  value="00:00"
                />
              </div>
            </div>
            <p class="pf-error" data-error-for="timeline"></p>
          </section>

          <section class="pf-step" data-step="3" data-section="Your day" hidden>
            <p class="pf-section-kicker">Your spaces</p>
            <h2>Tell us about the space(s) where the music will happen.</h2>
            <p class="pf-help">
              Select all that apply. This helps us plan sound systems and setup.
            </p>

            <fieldset class="pf-choice-group pf-checkbox-group">
              <label class="pf-choice">
                <input type="checkbox" name="space_type[]" value="ballroom" />
                <span>Ballroom</span>
              </label>
              <label class="pf-choice">
                <input type="checkbox" name="space_type[]" value="outdoors" />
                <span>Outdoors</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="space_type[]"
                  value="tent_or_marquee"
                />
                <span>Tent or marquee</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="space_type[]"
                  value="inside_a_house"
                />
                <span>Inside a house</span>
              </label>
              <label class="pf-choice">
                <input type="checkbox" name="space_type[]" value="backyard" />
                <span>Backyard</span>
              </label>
              <label class="pf-choice">
                <input type="checkbox" name="space_type[]" value="barn" />
                <span>Barn</span>
              </label>
              <label class="pf-choice pf-choice--other">
                <input
                  type="checkbox"
                  name="space_type[]"
                  value="other"
                  data-other-toggle="space_type_other"
                />
                <span>Other</span>
              </label>
            </fieldset>

            <div id="space_type_other_wrap" class="pf-inline-field" hidden>
              <label class="pf-field-label" for="space_type_other"
                >Other space type</label
              >
              <input
                id="space_type_other"
                name="space_type_other"
                class="pf-input"
                maxlength="150"
                placeholder="Tell us more"
              />
            </div>
            <p class="pf-error" data-error-for="space_type"></p>
          </section>

          <section class="pf-step" data-step="4" data-section="Your day" hidden>
            <p class="pf-section-kicker">Key moments</p>
            <h2>Which key moments would you like to highlight?</h2>
            <p class="pf-help">Select all that apply.</p>

            <fieldset class="pf-choice-group pf-checkbox-group">
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="grand_entrance"
                />
                <span>Grand entrance</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="first_dance"
                />
                <span>First dance</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="parent_dances"
                />
                <span>Parent dances</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="cake_cutting"
                />
                <span>Cake cutting</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="bouquet_garter"
                />
                <span>Bouquet/garter</span>
              </label>
              <label class="pf-choice">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="last_dance"
                />
                <span>Last dance or send-off</span>
              </label>
              <label class="pf-choice pf-choice--exclusive">
                <input
                  type="checkbox"
                  name="key_moments[]"
                  value="not_sure_yet"
                  data-exclusive="key_moments"
                />
                <span>I&apos;m not sure yet</span>
              </label>
            </fieldset>
            <p class="pf-error" data-error-for="key_moments"></p>
          </section>

          <section class="pf-step" data-step="5" data-section="Your day" hidden>
            <p class="pf-section-kicker">MC style</p>
            <h2>What kind of MC style fits your day?</h2>
            <fieldset class="pf-choice-group pf-radio-group">
              <label class="pf-choice pf-card-choice">
                <input
                  type="radio"
                  name="mc_style"
                  value="light_professional"
                />
                <span class="pf-card-title">Light and professional</span>
                <small>Keeps the event moving forward.</small>
              </label>
              <label class="pf-choice pf-card-choice">
                <input type="radio" name="mc_style" value="front_and_center" />
                <span class="pf-card-title">Front and center</span>
                <small>Tells jokes, leads line dances, takes the stage.</small>
              </label>
            </fieldset>
            <p class="pf-error" data-error-for="mc_style"></p>
          </section>

          <section class="pf-step" data-step="6" data-section="Your day" hidden>
            <p class="pf-section-kicker">Planner or coordinator</p>
            <h2>Do you have a planner or day-of coordinator?</h2>

            <fieldset
              class="pf-choice-group pf-radio-group"
              id="coordinator-group"
            >
              <label class="pf-choice">
                <input type="radio" name="coordinator" value="yes" />
                <span>Yes</span>
              </label>
              <label class="pf-choice">
                <input type="radio" name="coordinator" value="no" />
                <span>No</span>
              </label>
              <label class="pf-choice">
                <input type="radio" name="coordinator" value="not_sure" />
                <span>I&apos;m not sure yet</span>
              </label>
            </fieldset>
            <p class="pf-error" data-error-for="coordinator"></p>
          </section>

          <section
            class="pf-step"
            data-step="7"
            data-section="Your music"
            hidden
          >
            <p class="pf-section-kicker">Music genres</p>
            <h2>What do you want to hear on the dance floor?</h2>
            <p class="pf-help">Pick as many as you like.</p>

            <fieldset class="pf-choice-group pf-checkbox-group pf-chip-grid">
              <label class="pf-chip"
                ><input
                  type="checkbox"
